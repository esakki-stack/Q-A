# Optional application settings read by app/config.py
APP_NAME=NewsQAGenerator
APP_ENV=development
DEBUG=true
SECRET_KEY=

# Optional credentials for provider code; not needed by the active basic Q&A endpoint
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
NEWS_API_KEY=

# Local paths and generation settings
DATABASE_URL=sqlite:///./news_qa.db
MODEL_CACHE_DIR=./model_cache
DEFAULT_LANGUAGE=en
MAX_ARTICLE_LENGTH=10000
MIN_ARTICLE_LENGTH=500
DEFAULT_QUESTION_COUNT=10
MAX_QUESTION_COUNT=20
MIN_CONFIDENCE_THRESHOLD=0.7

# Server and upload settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.txt,.pdf,.docx,.doc

# Frontend (Vite reads this in ai-qa-dashboard)
VITE_API_URL=http://localhost:8000/api/v1
